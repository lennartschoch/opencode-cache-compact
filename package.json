{
  "name": "opencode-cache-compact",
  "version": "0.2.0",
  "description": "Cache-friendly context compaction for OpenCode (V1 and V2): append a summary in place, then cut what the model sees down to it.",
  "type": "module",
  "license": "MIT",
  "author": "Lennart Schoch",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lennartschoch/opencode-cache-compact.git"
  },
  "homepage": "https://github.com/lennartschoch/opencode-cache-compact#readme",
  "bugs": {
    "url": "https://github.com/lennartschoch/opencode-cache-compact/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:e2e": "OPENCODE_E2E=1 node --test test/e2e.test.ts",
    "test:e2e:v2": "OPENCODE_E2E_V2=1 node --test test/e2e-v2.test.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "compaction",
    "prompt-cache",
    "llama.cpp"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.9",
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "@opencode-ai/sdk": "^1.18.0",
    "@opencode/client": "^2.0.16",
    "@opencode/plugin": "^2.0.16",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
